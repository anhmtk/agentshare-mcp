{
  "schema": "https://modelcontextprotocol.io/schemas/mcp.json",
  "name": "agentshare",
  "displayName": "AgentShare — Agent-paid API + MCP",
  "description": "14 MCP tools on agent-paid rails (dual-auth API key or x402): commerce, request_capability, Market experiment (market_browse / market_list), plus secondary Solana/Meteora DeFi demos. Polymarket is not on the public MCP catalog. Streamable HTTP at agentshare.dev/mcp.",
  "version": "1.1.0",
  "author": "AgentShare",
  "homepage": "https://agentshare.dev",
  "license": "MIT",
  "repository": "https://github.com/anhmtk/agentshare-mcp",
  "icon": "https://agentshare.dev/static/logo.png",
  "categories": ["data", "ecommerce", "agents", "commerce", "payments"],
  "tags": [
    "agent-paid",
    "x402",
    "dual-auth",
    "price",
    "mcp",
    "ai-agent",
    "procurement",
    "commerce_quote",
    "aliexpress",
    "robotics",
    "defi",
    "solana",
    "meteora",
    "defillama"
  ],
  "endpoints": {
    "streamable-http": "https://agentshare.dev/mcp"
  },
  "tools": [
    "dex_overview",
    "dex_top_movers",
    "solana_dex_brief",
    "meteora_brief",
    "meteora_pool_detail",
    "search_products",
    "best_offer",
    "best_offer_under_budget",
    "product_detail",
    "commerce_quote",
    "request_capability",
    "market_browse",
    "market_list",
    "service_meta"
  ],
  "requiresApiKey": true,
  "apiKeyHeader": "X-API-Key",
  "registerUrl": "https://agentshare.dev/signup",
  "discovery": {
    "agent_json": "https://agentshare.dev/agent.json",
    "discovery_index": "https://agentshare.dev/.well-known/discovery.json",
    "for_agents": "https://agentshare.dev/for-agents",
    "server_card": "https://agentshare.dev/.well-known/mcp/server-card.json",
    "managed_agent_template": "https://agentshare.dev/api/v1/examples?template=managed-agent",
    "antigravity_skills": "https://agentshare.dev/.well-known/antigravity-skills.json",
    "github_ai_discovery": "https://raw.githubusercontent.com/anhmtk/agentshare-mcp/main/AI_DISCOVERY.json",
    "llms_txt": "https://raw.githubusercontent.com/anhmtk/agentshare-mcp/main/llms.txt",
    "market": "https://agentshare.dev/market",
    "market_listings": "https://agentshare.dev/api/v1/market/listings",
    "chrome_extension_store": "https://chromewebstore.google.com/detail/agentshare-agent-readiness/nimndnhajfkicbnipbfdkmgencjejjed",
    "chrome_extension_docs": "https://github.com/anhmtk/agentshare-mcp/blob/main/docs/CHROME_EXTENSION.md"
  }
}
