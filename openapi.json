{
  "openapi": "3.0.0",
  "info": {
    "title": "AgentShare Agent-paid API",
    "version": "1.1.0",
    "description": "Agent-paid API for autonomous agents: dual-auth (API key or x402), free discovery, MCP. Secondary modules: commerce procurement and Solana/Meteora DeFi demos. Pay per query with x402 v2: one exact accept on Base mainnet. EIP-712 domain name is USD Coin version 2.\n\nCanonical production: https://agentshare.dev. Prefer live /.well-known/x402 and agent.json for the current accept row.\n\nPricing posture (live): x402 pay-per-request primary; monthly API-key plans secondary.\n\n## Payment\nProtected endpoints return **HTTP 402** with a `PAYMENT-REQUIRED` header (x402Version 2, one exact row). Sign EIP-712 name USD Coin version 2 on Base mainnet (eip155:8453). Do not filter extra.name on the string USDC. Retry with PAYMENT-SIGNATURE.\n\n## Categories\n- **Agent-paid rails** — dual-auth, discovery, billing envelope\n- **Commerce** — Multi-source product search, best-offer, quote (AliExpress, Geekbuying, Temu, …)\n- **DeFi demos (secondary)** — live on canonical `https://agentshare.dev`",
    "contact": {
      "name": "AgentShare",
      "url": "https://agentshare.dev"
    },
    "license": {
      "name": "Apache-2.0"
    },
    "x-x402": {
      "version": 2,
      "scheme": "exact",
      "network": "eip155:8453",
      "asset": "USDC",
      "eip712Name": "USD Coin",
      "eip712Version": "2",
      "discovery": "https://agentshare.dev/.well-known/x402"
    }
  },
  "servers": [
    {
      "url": "https://agentshare.dev",
      "description": "Production. Live accept row: GET /.well-known/x402"
    },
    {
      "url": "http://localhost:4020",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Commerce",
      "description": "E-commerce product search and price comparison across international marketplaces"
    },
    {
      "name": "DeFi demos (secondary)",
      "description": "Solana DEX analytics and Meteora DLMM pool briefs — secondary demos, not the company backbone"
    },
    {
      "name": "System",
      "description": "Health check and service metadata"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "operationId": "healthCheck",
        "summary": "Health check",
        "description": "Public endpoint — no payment required. Returns service status and configuration.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": ["Commerce"],
        "operationId": "searchProducts",
        "summary": "Search products across marketplaces",
        "description": "Search for products (Mini PC, Raspberry Pi, Nvidia Jetson, Orange Pi, etc.) across AliExpress and other international marketplaces.\n\n**x402 Payment:** $0.001 USDC per query. Sign the exact USD Coin row on Base mainnet (eip155:8453).",
        "x-x402-price": "$0.001",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "mini pc" },
            "description": "Search keyword"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 5, "minimum": 1, "maximum": 50 },
            "description": "Max number of results to return"
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "USD", "enum": ["USD", "VND", "EUR"] },
            "description": "Price currency"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search with payment receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaidSearchResponse"
                },
                "example": {
                  "status": "ok",
                  "payment": {
                    "verified": true,
                    "payer": "0x6692cd35E665e1E674742aC098935FC76dEBB0e5",
                    "amount": "1000",
                    "network": "eip155:8453",
                    "transaction": "313fc1f7-34ff-4d97-9636-e32a473bb179"
                  },
                  "data": {
                    "status": "ok",
                    "results": [
                      {
                        "title": "Raspberry Pi 4 Model B 8GB",
                        "price": 405.0,
                        "price_usd": 405.0,
                        "currency": "USD",
                        "source": "aliexpress",
                        "url": "https://aliexpress.com/item/..."
                      }
                    ],
                    "meta": {
                      "total": 15,
                      "query": "mini pc",
                      "billing": {
                        "model": "free",
                        "x402_ready": true,
                        "endpoint_id": "search_products",
                        "price_usd": 0.001
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required — retry with PAYMENT-SIGNATURE header",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded JSON with x402Version, resource, and accepts[] array",
                "schema": { "type": "string" }
              }
            }
          },
          "502": {
            "description": "Upstream API error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/best-offer": {
      "get": {
        "tags": ["Commerce"],
        "operationId": "bestOffer",
        "summary": "Find the single cheapest in-stock offer",
        "description": "Returns the best-price offer for a product query across all tracked marketplaces.\n\n**x402 Payment:** $0.001 USDC per query. Sign the exact USD Coin row on Base mainnet (eip155:8453).",
        "x-x402-price": "$0.001",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "nvidia jetson" },
            "description": "Product search keyword"
          }
        ],
        "responses": {
          "200": {
            "description": "Best offer found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaidDataResponse" }
              }
            }
          },
          "402": {
            "description": "Payment required"
          }
        }
      }
    },
    "/api/v1/product/{id}": {
      "get": {
        "tags": ["Commerce"],
        "operationId": "productDetail",
        "summary": "Get full product details and per-source prices",
        "description": "Retrieve detailed product information including prices from all tracked sources.\n\n**x402 Payment:** $0.001 USDC per query. Sign the exact USD Coin row on Base mainnet (eip155:8453).",
        "x-x402-price": "$0.001",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Product ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Product details with payment receipt",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaidDataResponse" }
              }
            }
          },
          "402": {
            "description": "Payment required"
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "service": { "type": "string", "example": "agentshare-x402-seller" },
          "chain": { "type": "string", "example": "eip155:8453" },
          "facilitator": { "type": "string", "example": "https://agentshare.dev/.well-known/x402" },
          "price": { "type": "string", "example": "$0.001" }
        }
      },
      "PaymentReceipt": {
        "type": "object",
        "description": "x402 settlement receipt attached to a paid response",
        "properties": {
          "verified": { "type": "boolean" },
          "payer": { "type": "string", "description": "Buyer wallet address" },
          "amount": { "type": "string", "description": "Amount in USDC atomic units" },
          "network": { "type": "string", "description": "CAIP-2 network identifier", "example": "eip155:8453" },
          "transaction": { "type": "string", "description": "Settlement transaction id" }
        }
      },
      "PaidSearchResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "payment": { "$ref": "#/components/schemas/PaymentReceipt" },
          "data": {
            "type": "object",
            "description": "Upstream API response (product results + meta)"
          }
        }
      },
      "PaidDataResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "payment": { "$ref": "#/components/schemas/PaymentReceipt" },
          "data": {
            "type": "object",
            "description": "Upstream API response"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["error"] },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
